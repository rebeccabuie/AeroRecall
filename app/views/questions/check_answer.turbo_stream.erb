<%= turbo_stream.update "question_#{@question.id}_result" do %>
  <% if @correct %>
    <p>Correct! ✅</p>
  <% else %>
    <p>Not quite.</p>
  <% end %>

  <p>
    Correct answer:
    <strong>
      <%= @question.correct_option %>.
      <%= @question.public_send("option_#{@question.correct_option.downcase}") %>
    </strong>
  </p>

  <p><%= @question.explanation %></p>
<% end %>

<%= turbo_stream.remove "question_#{@question.id}_form" %>

<% if authenticated? %>
  <%= turbo_stream.update "score" do %>
    <div>
      Score:
      <%= @card_completed ? @correct_answers : Current.user.question_attempts.where(question: @study_card.questions, correct: true).count %>
      /
      <%= @total_questions %>
      <br>

      Answered:
      <%= @questions_answered %>
      /
      <%= @total_questions %>
    </div>
  <% end %>
<% end %>

<% if @card_completed %>
  <%= turbo_stream.update "completion_message" do %>
    <div class="quiz-results">
      <h2>Quiz Complete!</h2>

      <p class="quiz-results-score">
        <strong>
          <%= @correct_answers %> / <%= @total_questions %>
          — <%= @score_percentage %>%
        </strong>
      </p>

      <% if @missed_count.zero? %>
        <p>Perfect score! 🎉</p>

      <% elsif @score_percentage >= 80 %>
        <p>Nice work! You passed this card. 🎉</p>

        <p>
          You missed <%= pluralize(@missed_count, "question") %>.
          Review them to lock it in.
        </p>

      <% else %>
        <p>
          You missed <%= pluralize(@missed_count, "question") %>.
          Let's review those before moving on.
        </p>
      <% end %>

      <% if @missed_count.positive? %>
        <%= link_to "Review #{pluralize(@missed_count, "Missed Question")}",
                    review_path(
                      mode: "missed",
                      study_card_id: @study_card.id
                    ),
                    class: "study-nav-button study-nav-primary" %>
      <% end %>
    </div>
  <% end %>
<% end %>
